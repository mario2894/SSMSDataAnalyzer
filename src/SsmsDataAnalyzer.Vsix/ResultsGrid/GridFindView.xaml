<UserControl x:Class="SsmsDataAnalyzer.Vsix.ResultsGrid.GridFindView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
             FocusManager.FocusedElement="{Binding ElementName=SearchTextBox}">
    <!--
        v0.7.2: results-grid Find moved from a floating WPF Window to a real VS
        ToolWindowPane (see GridFindToolWindow) after the floating window proved unable to
        reliably own keyboard focus/routing inside the SSMS host — typing, Backspace and
        Enter were reaching the SQL editor underneath instead of this control, and Ctrl+F
        turned out to be intercepted by VS's own Find and Replace before it ever reached the
        results grid. A real ToolWindowPane sidesteps both: VS owns focus and keyboard
        routing for its own tool windows, so this control just needs ordinary WPF event
        handlers, no WindowInteropHelper/Activate/Keyboard.Focus workarounds at all.

        Same lean widget shape as before: text box, explicit Find button (never
        search-as-you-type — a keystroke must not launch a full chunked scan), N-of-M
        counter, prev/next. No Close button — a VS tool window closes via its own tab, not
        ours; no options panel, no regex (lead's "keep it lean" still applies).
    -->
    <StackPanel Orientation="Horizontal" Margin="6" KeyDown="Root_KeyDown">
        <TextBox x:Name="SearchTextBox" Width="180" VerticalAlignment="Center"
                 TextChanged="SearchTextBox_TextChanged" />
        <Button x:Name="FindButton" Content="Find" Click="FindButton_Click"
                ToolTip="Search (Enter)" Padding="6,2" Margin="4,0,0,0" />
        <TextBlock x:Name="CounterText" VerticalAlignment="Center"
                   Margin="8,0,8,0" MinWidth="150"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
        <Button x:Name="PreviousButton" Content="▲" Click="PreviousButton_Click"
                ToolTip="Previous match (Shift+F3 / Shift+Enter)" Padding="6,2" Margin="0,0,2,0" />
        <Button x:Name="NextButton" Content="▼" Click="NextButton_Click"
                ToolTip="Next match (F3 / Enter)" Padding="6,2" Margin="0,0,2,0" />
        <Button x:Name="CancelButton" Content="Cancel" Click="CancelButton_Click"
                ToolTip="Cancel the current search" Padding="6,2" Visibility="Collapsed" />
    </StackPanel>
</UserControl>
