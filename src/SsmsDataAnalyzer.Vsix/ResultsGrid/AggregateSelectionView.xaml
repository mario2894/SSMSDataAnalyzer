<UserControl x:Class="SsmsDataAnalyzer.Vsix.ResultsGrid.AggregateSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vsp="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             mc:Ignorable="d"
             d:DesignHeight="260" d:DesignWidth="360"
             Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">

    <UserControl.Resources>
        <!-- Same "solid VS theme colour, never a hardcoded one" convention as
             Pivot/PivotView.xaml — only EXISTING EnvironmentColors keys. -->
        <SolidColorBrush x:Key="ContextTextBrush" Color="{DynamicResource {x:Static vsp:EnvironmentColors.SystemGrayTextColorKey}}" />
        <SolidColorBrush x:Key="RowHoverBrush" Color="{DynamicResource {x:Static vsp:EnvironmentColors.SystemHighlightColorKey}}" Opacity="0.15" />
        <SolidColorBrush x:Key="LabelTextBrush" Color="{DynamicResource {x:Static vsp:EnvironmentColors.SystemWindowTextColorKey}}" />
    </UserControl.Resources>

    <StackPanel Margin="12">
        <!-- One row per statistic. Each row is individually copyable: double-click, or
             right-click → Copy value. Ctrl+C (wired in AggregateSelectionToolWindow, the same
             pane-local VSStd97 Copy shape as Peek/PivotToolWindow) copies ALL rows at once as
             "Label\tValue" lines via AggregateSelectionView.CopyCommand(). -->
        <ItemsControl x:Name="RowsList" ItemsSource="{Binding Rows}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Padding="4,3" Cursor="Hand"
                            MouseLeftButtonDown="Row_MouseLeftButtonDown"
                            ToolTip="Double-click, or right-click → Copy value">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource RowHoverBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copy value" Click="CopyValueMenuItem_Click" />
                            </ContextMenu>
                        </Border.ContextMenu>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Label, Mode=OneWay}"
                                       FontWeight="SemiBold" Foreground="{StaticResource LabelTextBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding Value, Mode=OneWay}"
                                       Foreground="{StaticResource LabelTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Small gray context line ("N cells selected · M NULL · K not numeric") — only
             shown when there is something extra worth saying (see
             AggregateSelectionViewModel.HasContextLine / SelectionAggregator.ContextLine). -->
        <TextBlock Text="{Binding ContextLine, Mode=OneWay}" Foreground="{StaticResource ContextTextBrush}"
                   Margin="4,8,0,0" TextWrapping="Wrap" FontSize="11">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasContextLine}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</UserControl>
